# Interactive GRENDEL event display. Run from the build directory with:
#   ./grendelSim
#   /control/execute vis.mac
#   /run/beamOn 1

/run/initialize

/vis/verbose errors
/vis/open OGL 1200x900-0+0
/vis/viewer/set/style surface
/vis/viewer/set/background white
/vis/viewer/set/autoRefresh false
/vis/viewer/set/upVector 1 0 0
/vis/viewer/set/viewpointVector 0 0 1

/vis/drawVolume
/vis/viewer/zoomTo 3.5
/vis/scene/endOfEventAction accumulate 1
/tracking/storeTrajectory 1
/vis/scene/add/trajectories

/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set neutron magenta
/vis/modeling/trajectories/drawByParticleID-0/set e+ yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- black
/vis/modeling/trajectories/drawByParticleID-0/set mu- red
/vis/modeling/trajectories/drawByParticleID-0/set proton orange
/vis/viewer/set/autoRefresh true
/vis/viewer/flush

# A lightweight default cosmic muon for interactive single-event viewing.
# These commands affect visualization sessions only; production macros retain
# their propagated cosmic spectrum and beam-file generator unchanged.
/gps/particle mu-
/gps/pos/type Point
/gps/pos/centre 290 0 -50 cm
/gps/direction -1 0 0
/gps/ene/type Mono
/gps/ene/mono 4 GeV
